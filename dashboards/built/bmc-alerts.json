es old. This is the expected state for all hosts. Any host not counted here needs investigation."},"plugin":{"kind":"StatChart","spec":{"calculation":"last"}},"queries":[{"kind":"TimeSeriesQuery","spec":{"plugin":{"kind":"PrometheusTimeSeriesQuery","spec":{"datasource":"$datasource","query":"count((time() - redfish_event_pipeline_test_timestamp{result=\"success\"} * on(hostname) group_left() label_replace(kube_ironcore_bmc_info{region=~\"$region\",buildingBlock=~\"$bb\",nodename=~\"$node\",manufacturer=~\"$manufacturer\",model=~\"$model\"}, \"hostname\", \"$1\", \"name\", \"(.*)\")) \u003c 300) or vector(0)"}}}}]}},"2_1":{"kind":"Panel","spec":{"display":{"name":"Stale Hosts (age \u003e 15 min)","description":"Number of hosts where the last successful health-check is more than 15 minutes old, indicating likely pipeline disruption. Zero is the healthy steady state."},"plugin":{"kind":"StatChart","spec":{"calculation":"last"}},"queries":[{"kind":"TimeSeriesQuery","spec":{"plugin":{"kind":"PrometheusTimeSeriesQuery","spec":{"datasource":"$datasource","query":"count(label_replace(kube_ironcore_bmc_info{region=~\"$region\",buildingBlock=~\"$bb\",nodename=~\"$node\",manufacturer=~\"$manufacturer\",model=~\"$model\"}, \"hostname\", \"$1\", \"name\", \"(.*)\") unless on(hostname) (redfish_event_pipeline_test_timestamp{result=\"success\"} \u003e (time() - 900))) or vector(0)"}}}}]}},"2_2":{"kind":"Panel","spec":{"display":{"name":"Worst Pipeline Age (s)","description":"Highest pipeline age across all selected hosts. If this exceeds the configured test interval the worst-performing host is not receiving health-check events. A spike here that quickly resolves indicates a transient delivery delay rather than a broken pipeline."},"plugin":{"kind":"StatChart","spec":{"calculation":"last"}},"queries":[{"kind":"TimeSeriesQuery","spec":{"plugin":{"kind":"PrometheusTimeSeriesQuery","spec":{"datasource":"$datasource","query":"max(time() - redfish_event_pipeline_test_timestamp{result=\